<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arbor.mapper.FlowMapper">

    <resultMap id="BaseResultMap" type="com.arbor.entity.Flow">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="user_id" property="userId"/>
        <result column="status" property="status"/>
        <result column="node_count" property="nodeCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM flow
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="nodeCount != null">
                AND node_count = #{nodeCount}
            </if>
        </where>
        ORDER BY ${sortField} ${sortOrder}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM flow WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO flow (name, description, status, node_count, uid)
        VALUES (#{name}, #{description}, #{status}, #{nodeCount}, #{uid})
    </insert>

    <update id="update">
        UPDATE flow SET name = #{name}, description = #{description} WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE flow SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updateNodeCount">
        UPDATE flow SET node_count = #{nodeCount} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM flow WHERE id = #{id}
    </delete>

    <select id="countByNameAndUser" resultType="long">
        SELECT COUNT(*) FROM flow WHERE name = #{name} AND user_id = #{userId}
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT * FROM flow WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectByIdsIgnoreTenant" resultMap="BaseResultMap">
        SELECT * FROM flow WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
